{
  "name": "la-petite-vague-mouvement",
  "private": true,
  "description": "Fabrique /accueil.js (page d'accueil, depuis accueil.js) et /mouvement.js (autres pages, depuis source.js)",
  "scripts": {
    "build": "esbuild source.js --bundle --minify --format=iife --target=es2018 --legal-comments=none --outfile=../mouvement.js && esbuild accueil.js --bundle --minify --format=iife --target=es2018 --legal-comments=none --outfile=../accueil.js"
  },
  "dependencies": {
    "motion": "14.6.0"
  },
  "devDependencies": {
    "esbuild": "0.25.10"
  }
}
