# La petite vague — réglages du serveur (utile seulement si le site est hébergé
# chez Hostinger ; sur GitHub Pages ce fichier est ignoré et inoffensif).

# 1. Tout le trafic en HTTPS, et sans le www
RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# 2. Compression : la page fait 349 Ko bruts, 78 Ko compressée
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript image/svg+xml
</IfModule>

# 3. Mise en cache : un an pour les photos, une heure pour la page
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/html "access plus 1 hour"
</IfModule>
